.bg-gray-800.p-5.rounded-2xl.border.border-gray-700.shadow-sm.mb-4
  .flex.items-start.space-x-4
    .bg-blue-600.h-8.w-8.rounded-full.flex.items-center.justify-center.flex-shrink-0
      span.text-xs.font-bold Q
    .flex-1
      p.text-gray-400.text-sm.mb-1 = question.user_query
      .text-gray-100.leading-relaxed.mb-4.text-justify style="text-align: justify;"
        = simple_format question.ai_response

      .mt-4.pt-4.border-t.border-gray-700
        span.text-xs.font-semibold.text-gray-500.uppercase.tracking-widest Sources:
        .flex.flex-wrap.gap-2.mt-2
          - question.metadata["source_document_names"].each do |name|
            span.px-2.py-1.bg-gray-900.text-blue-400.text-xs.rounded-md.border.border-blue-900/30
              i.fas.fa-file-alt.mr-1
              = name
script
    | document.querySelector('[data-controller="assistant"]').dispatchEvent(new CustomEvent('type-trigger'));